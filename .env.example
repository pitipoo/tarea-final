NODE_ENV=development
PORT=3000
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/research.db
PUBLIC_URL=http://localhost:3000

# Optional SMTP settings. In local development reset links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Atlas Research <no-reply@example.com>

# Optional first administrator. Both values must be set together.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Sentry server-side error reporting DSN.
SENTRY_DSN=
